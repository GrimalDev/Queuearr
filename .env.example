# Copy to .env for Docker Compose. Keep real values out of Git.
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Generate once with: uuidgen. Keep it stable between requests and restarts.
PLEX_CLIENT_ID=
# From your Plex server's /identity response. Required for login.
PLEX_SERVER_MACHINE_IDENTIFIER=
# Required for library sharing and invite management.
PLEX_ADMIN_TOKEN=

DATA_PATH=./data

# Voluntary payment prompts. Set true to enable; false or unset disables them.
FAKE_PAYWALL_ENABLED=false

# Use host.docker.internal when these services run directly on the Mac.
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
TRANSMISSION_URL=
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@queuearr.local

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# If your services require a custom CA, provide plex-local.pem and include
# docker-compose.cert.yml. It sets NODE_EXTRA_CA_CERTS and SERVICE_CA_CERT_PATH.
# For host development only, set SERVICE_CA_CERT_PATH to the local certificate.
